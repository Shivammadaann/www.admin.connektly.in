VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
VITE_TURNSTILE_LOCAL_SITE_KEY=optional-localhost-turnstile-site-key

# Server-only. Never expose this value in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Comma-separated owner emails or Supabase auth user IDs allowed into this dashboard.
ADMIN_ALLOWED_EMAILS="owner@connektly.in,admin@connektly.in"
ADMIN_ALLOWED_USER_IDS=
PRIMARY_OWNER_EMAIL="admin@connektly.in"

# Optional: used by the server status page to verify the client app API.
CLIENT_API_BASE_URL=https://www.app.connektly.in/api
META_WEBHOOK_VERIFY_TOKEN=your-meta-whatsapp-webhook-verify-token
MESSENGER_WEBHOOK_VERIFY_TOKEN=your-messenger-webhook-verify-token

# Sends "Request to Join Admin Control Panel" emails from the login page.
ADMIN_ACCESS_REQUEST_EMAIL=Admin@connektly.in
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Connektly Admin <no-reply@connektly.in>"

# Used by Website Management to edit the separately deployed public website over HTTPS.
WEBSITE_PUBLIC_BASE_URL=https://connektly.in
WEBSITE_API_BASE_URL=https://connektly.in/api
WEBSITE_CONTENT_SYNC_TOKEN=use-the-same-random-secret-in-admin-and-website

# Optional local-dev fallback only. Leave unset in production deployments.
# WEBSITE_CONTENT_ROOT=/absolute/path/to/local/www.connektly.in

# Optional: if you later add live Razorpay subscription reconciliation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PORT=8787
