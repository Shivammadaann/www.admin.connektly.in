VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
VITE_TURNSTILE_LOCAL_SITE_KEY=optional-localhost-turnstile-site-key

# Server-only. Never expose this value in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Comma-separated owner emails or Supabase auth user IDs allowed into this dashboard.
ADMIN_ALLOWED_EMAILS=owner@connektly.in
ADMIN_ALLOWED_USER_IDS=

# Optional: used by the server status page to verify the client app API.
CLIENT_API_BASE_URL=https://www.app.connektly.in/api

# Optional: used by Website Management to edit www.connektly.in blogs/help JSON and uploaded media.
WEBSITE_CONTENT_ROOT=../www.connektly.in
WEBSITE_PUBLIC_BASE_URL=https://www.connektly.in
WEBSITE_LEAD_FORMS_FILE=../www.connektly.in/data/lead-form-submissions.json

# Optional: if you later add live Razorpay subscription reconciliation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PORT=8787
